  "title_de": "Meine Familie",
  "title_en": "My Family",
  "topic": "identifying close family members in a photo",
  "communicative_goal": "Name close family members and say who they are.",
  "grammar_focus": "possessive determiners mein/dein in nominative noun phrases",
  "supporting_structures": [
    "Das ist meine Mutter.",
    "Ist das dein Bruder?",
    "mit dem Kind"
  ],
  "grammar_notes": [
    "Meine and dein are possessive determiners agreeing with the following nominative noun.",
    "Mit governs dative, so dem Kind is neuter dative."
  ],
