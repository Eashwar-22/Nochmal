  "title_de": "Das ist meine Freundin",
  "title_en": "This Is My Friend",
  "topic": "introducing friends from a course",
  "communicative_goal": "Introduce a friend and identify another person nearby.",
  "grammar_focus": "nominative noun phrases after sein and who-questions",
  "supporting_structures": [
    "Das ist Sara.",
    "eine Freundin aus dem Kurs",
    "Wer ist der Mann dort?",
    "Er heißt Amir."
  ],
  "grammar_notes": [
    "Das ist Sara and Wer ist der Mann dort use sein before a nominative predicate or subject phrase.",
    "Eine Freundin is a feminine nominative apposition to Sara.",
    "Aus always governs dative; dem Kurs is masculine dative.",
    "Er is the masculine nominative personal pronoun referring to der Mann."
  ],
