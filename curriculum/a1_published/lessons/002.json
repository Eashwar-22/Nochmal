  "title_de": "Woher kommst du?",
  "title_en": "Where Are You From?",
  "topic": "origin and place of residence",
  "communicative_goal": "Ask where someone comes from and where they live.",
  "grammar_focus": "W-questions with wo and woher; first- and second-person present tense",
  "supporting_structures": [
    "Woher kommst du?",
    "Wo wohnst du?",
    "Ich komme aus …",
    "Ich wohne in …"
  ],
  "grammar_notes": [
    "Woher asks about origin; wo asks about location.",
    "W-questions place the conjugated verb after the question word and before the subject.",
    "Aus takes the dative; in takes the dative here because it describes a fixed location."
  ],
