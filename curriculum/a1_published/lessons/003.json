  "title_de": "Noch einmal, bitte",
  "title_en": "Please Say It Again",
  "topic": "communication repair and polite repetition",
  "communicative_goal": "Signal a misunderstanding and ask someone to repeat more slowly.",
  "grammar_focus": "fixed polite repair chunks with bitte and elliptical requests",
  "supporting_structures": [
    "Wie bitte?",
    "Noch einmal, bitte.",
    "langsam sprechen",
    "Danke."
  ],
  "grammar_notes": [
    "Wie bitte? is a polite fixed expression used when something was not understood.",
    "Noch einmal, bitte. is an elliptical request: the action to repeat is understood from context.",
    "Sentence-initial jetzt is followed by the finite verb before the subject."
  ],
