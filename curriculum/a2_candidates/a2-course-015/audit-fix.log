"""Reusable German inflection paradigms and typed phrase annotations.

This module is the single source of truth for case-reference tables.  Lesson
content supplies context through controlled tags; the renderer never receives
lesson-authored tooltip prose.
"""

from __future__ import annotations

import re

from .models import BreakdownGroup, BreakdownItem, GrammarCase, InflectionHelp


CASES: tuple[GrammarCase, ...] = (
    "nominative",
    "accusative",
    "dative",
    "genitive",
)
GENDERS = ("masculine", "feminine", "neuter", "plural")
PRONOUN_COLUMNS = (
    "ich",
    "du",
    "er",
    "sie",
    "es",
    "wir",
    "ihr",
    "sie / Sie",
)
PRONOUN_SLOTS = (
    "first-singular",
    "second-singular",
    "third-masculine",
    "third-feminine",
    "third-neuter",
    "first-plural",
    "second-plural",
    "third-plural-formal",
)

DEFINITE_ARTICLES = {
    "nominative": ("der", "die", "das", "die"),
    "accusative": ("den", "die", "das", "die"),
    "dative": ("dem", "der", "dem", "den"),
    "genitive": ("des", "der", "des", "der"),
}
INDEFINITE_ARTICLES = {
    "nominative": ("ein", "eine", "ein", "—"),
    "accusative": ("einen", "eine", "ein", "—"),
    "dative": ("einem", "einer", "einem", "—"),
    "genitive": ("eines", "einer", "eines", "—"),
}
NEGATIVE_DETERMINERS = {
    "nominative": ("kein", "keine", "kein", "keine"),
    "accusative": ("keinen", "keine", "kein", "keine"),
    "dative": ("keinem", "keiner", "keinem", "keinen"),
    "genitive": ("keines", "keiner", "keines", "keiner"),
}
POSSESSIVE_ENDINGS = {
    "nominative": ("", "e", "", "e"),
    "accusative": ("en", "e", "", "e"),
    "dative": ("em", "er", "em", "en"),
    "genitive": ("es", "er", "es", "er"),
}
DER_WORD_ENDINGS = {
    "nominative": ("er", "e", "es", "e"),
    "accusative": ("en", "e", "es", "e"),
    "dative": ("em", "er", "em", "en"),
    "genitive": ("es", "er", "es", "er"),
}
DER_WORD_BASES = {
    "dieser": "dies",
    "jeder": "jed",
    "welcher": "welch",
}
ADJECTIVE_ENDINGS = {
    "weak-adjective": {
        "nominative": ("-e", "-e", "-e", "-en"),
        "accusative": ("-en", "-e", "-e", "-en"),
        "dative": ("-en", "-en", "-en", "-en"),
        "genitive": ("-en", "-en", "-en", "-en"),
    },
    "mixed-adjective": {
        "nominative": ("-er", "-e", "-es", "-en"),
        "accusative": ("-en", "-e", "-es", "-en"),
        "dative": ("-en", "-en", "-en", "-en"),
        "genitive": ("-en", "-en", "-en", "-en"),
    },
    "strong-adjective": {
        "nominative": ("-er", "-e", "-es", "-e"),
        "accusative": ("-en", "-e", "-es", "-e"),
        "dative": ("-em", "-er", "-em", "-en"),
        "genitive": ("-en", "-er", "-en", "-er"),
    },
}
PERSONAL_PRONOUNS = {
    "nominative": ("ich", "du", "er", "sie", "es", "wir", "ihr", "sie / Sie"),
    "accusative": ("mich", "dich", "ihn", "sie", "es", "uns", "euch", "sie / Sie"),
    "dative": ("mir", "dir", "ihm", "ihr", "ihm", "uns", "euch", "ihnen / Ihnen"),
    "genitive": ("meiner", "deiner", "seiner", "ihrer", "seiner", "unser", "euer", "ihrer / Ihrer"),
}

CONTRACTIONS = {
    "am": ("an + dem", "dem"),
    "ans": ("an + das", "das"),
    "aufs": ("auf + das", "das"),
    "beim": ("bei + dem", "dem"),
    "durchs": ("durch + das", "das"),
    "fürs": ("für + das", "das"),
    "im": ("in + dem", "dem"),
    "ins": ("in + das", "das"),
    "ums": ("um + das", "das"),
    "vom": ("von + dem", "dem"),
    "zum": ("zu + dem", "dem"),
    "zur": ("zu + der", "der"),
}
POSSESSIVE_STEMS = ("unser", "euer", "mein", "dein", "sein", "ihr")
TOKEN_RE = re.compile(r"\w+(?:[-’']\w+)*", flags=re.UNICODE)


def table_for_help(help_card: InflectionHelp) -> dict[str, tuple[str, ...]]:
    """Return the complete immutable-layout table selected by typed metadata."""
    if help_card.paradigm == "definite":
        return DEFINITE_ARTICLES
    if help_card.paradigm == "indefinite":
        return INDEFINITE_ARTICLES
    if help_card.paradigm == "negative":
        return NEGATIVE_DETERMINERS
    if help_card.paradigm == "possessive":
        stem = help_card.base.rstrip("-")
        return {
            case: tuple(
                "—" if ending == "—" else f"{stem}{ending}"
                for ending in endings
            )
            for case, endings in POSSESSIVE_ENDINGS.items()
        }
    if help_card.paradigm == "der-word":
        stem = DER_WORD_BASES[help_card.base.casefold()]
        return {
            case: tuple(f"{stem}{ending}" for ending in endings)
            for case, endings in DER_WORD_ENDINGS.items()
        }
    if help_card.paradigm == "personal-pronoun":
        return PERSONAL_PRONOUNS
    return ADJECTIVE_ENDINGS[help_card.paradigm]


def columns_for_help(help_card: InflectionHelp) -> tuple[str, ...]:
    return PRONOUN_COLUMNS if help_card.kind == "personal-pronoun" else GENDERS


def selected_column_for_help(help_card: InflectionHelp) -> int:
    if help_card.kind == "personal-pronoun":
        if help_card.pronoun_slot is None:
            raise ValueError("Personal-pronoun help is missing its slot")
        return PRONOUN_SLOTS.index(help_card.pronoun_slot)
    if help_card.gender is None:
        raise ValueError("Inflection help is missing grammatical gender")
    return GENDERS.index(help_card.gender)


def _noun_gender(item: BreakdownItem, article: str) -> str:
    labels = {tag.label for tag in item.tags}
    if "plural" in labels:
        return "plural"
    if "masc." in labels:
        return "masculine"
    if "fem." in labels:
        return "feminine"
    if "neuter" in labels:
        return "neuter"
    return {"der": "masculine", "das": "neuter"}.get(article, "feminine")


def _table_cases(
    table: dict[str, tuple[str, ...]], gender: str, surface: str
) -> set[str]:
    column = GENDERS.index(gender)
    return {
        case
        for case, row in table.items()
        if row[column].casefold() == surface.casefold()
    }


def _possessive_stem(surface: str) -> str | None:
    key = surface.casefold()
    for stem in POSSESSIVE_STEMS:
        normalized_stem = "eur" if stem == "euer" and key.startswith("eur") else stem
        if not key.startswith(normalized_stem):
            continue
        if any(
            key == f"{normalized_stem}{ending}"
            for endings in POSSESSIVE_ENDINGS.values()
            for ending in endings
            if ending != "—"
        ):
            return stem
    return None


def _der_word_base(surface: str) -> str | None:
    key = surface.casefold()
    for base, stem in DER_WORD_BASES.items():
        if any(
            key == f"{stem}{ending}"
            for endings in DER_WORD_ENDINGS.values()
                    surface.casefold(),
                    POSSESSIVE_GLOSSES.get(surface.casefold(), item.english),
                )
            _extend_tags(item, tuple(labels))
            if authored_base is not None and set(labels) & {
                "adjective", "adverb", "article", "determiner", "pronoun",
                "personal pronoun", "interrogative pronoun", "relative pronoun",
                "reflexive pronoun", "indefinite pronoun", "preposition",
                "conjunction", "particle", "numeral",
            }:
                item.tags = [
                    grammar_tag
                    for grammar_tag in item.tags
                    if grammar_tag.label != "proper noun"
                ]
        if labels := excluded_word_tags.get(surface.casefold()):
            item.tags = [tag_ for tag_ in item.tags if tag_.label not in labels]

    occurrence_annotations = {
        (item.surface.casefold(), item.occurrence): item
        for item in annotations.word_occurrences
    }
    occurrence_counts: dict[str, int] = {}
    for surface, item in zip(surfaces, words, strict=True):
        key = surface.casefold()
        occurrence_counts[key] = occurrence_counts.get(key, 0) + 1
        authored = occurrence_annotations.get((key, occurrence_counts[key]))
        if authored is None:
            continue
        if authored.base_form is not None:
            item.german = authored.base_form
        if authored.meaning is not None:
            item.english = authored.meaning
        if authored.spoken_form is not None:
            item.spoken_form = authored.spoken_form
        _extend_tags(item, tuple(authored.tags))
        if authored.excluded_tags:
            excluded_labels = set(authored.excluded_tags)
            item.tags = [
                tag_ for tag_ in item.tags if tag_.label not in excluded_labels
            ]

    # Exclusions remove only compiler-generated candidates.  An author can
    # deliberately replace one of them below with a corrected phrase card.
    excluded = {
        " ".join(token.casefold() for token in WORD_RE.findall(german))
        for german in annotations.excluded_phrases
    }
    available_phrases = {
        " ".join(token.casefold() for token in WORD_RE.findall(phrase.german))
        for phrase in phrases
    }
    missing_exclusions = excluded - available_phrases
    if missing_exclusions:
        raise ValueError(
            "Excluded phrases were not generated: "
            + ", ".join(sorted(missing_exclusions))
        )
    phrases[:] = [
        phrase
        for phrase in phrases
        if " ".join(
            token.casefold() for token in WORD_RE.findall(phrase.german)
        ) not in excluded
    ]

    by_normalized_phrase: dict[str, BreakdownItem] = {}
    for phrase in phrases:
        normalized = " ".join(
            token.casefold() for token in WORD_RE.findall(phrase.german)
        )
        by_normalized_phrase.setdefault(normalized, phrase)
    for authored in annotations.phrases:
        normalized = " ".join(
            token.casefold() for token in WORD_RE.findall(authored.german)
        )
        phrase = by_normalized_phrase.get(normalized)
        if phrase is None:
            if authored.english is None:
                raise ValueError(
                    f"Authored phrase {authored.german!r} needs an English meaning "
                    "because the generic compiler did not create it"
                )
            phrase = BreakdownItem(
                german=authored.german,
                english=authored.english,
                literal_meaning=authored.literal_meaning,
                kind="phrase",
            )
            phrases.append(phrase)
            by_normalized_phrase[normalized] = phrase
        elif authored.english is not None:
            phrase.english = authored.english
        # Preserve meaningful authored punctuation such as the ordinal marker
        # in ``am 6. Mai`` without rewriting capitalization on every existing
        # compiler-generated phrase.
        if "." in authored.german and "." not in phrase.german:
            phrase.german = authored.german
        if authored.literal_meaning is not None:
            phrase.literal_meaning = authored.literal_meaning
        _extend_tags(phrase, tuple(authored.tags))

    excluded_tags = {
        " ".join(token.casefold() for token in WORD_RE.findall(german)): set(labels)
        for german, labels in annotations.excluded_phrase_tags.items()
    }
    phrase_groups: dict[str, list[BreakdownItem]] = {}
    for phrase in phrases:
        normalized = " ".join(
            token.casefold() for token in WORD_RE.findall(phrase.german)
        )
        phrase_groups.setdefault(normalized, []).append(phrase)
    missing_tag_exclusions = excluded_tags.keys() - phrase_groups.keys()
    if missing_tag_exclusions:
        raise ValueError(
            "Phrase-tag exclusions reference missing phrases: "
            + ", ".join(sorted(missing_tag_exclusions))
        )
    for normalized, labels in excluded_tags.items():
        current_labels = {
            tag_.label
            for phrase in phrase_groups[normalized]
            for tag_ in phrase.tags
        }
        missing_labels = labels - current_labels
        if missing_labels:
            raise ValueError(
                f"Phrase-tag exclusions for {normalized!r} reference tags that "
                f"were not generated: {sorted(missing_labels)}"
            )
    for phrase in phrases:
        normalized = " ".join(
            token.casefold() for token in WORD_RE.findall(phrase.german)
        )
        if labels := excluded_tags.get(normalized):
            phrase.tags = [tag_ for tag_ in phrase.tags if tag_.label not in labels]


def _sentence_groups(
    text: str,
    meaning: str,
    lesson_targets: list[str],
    annotations: SentenceAnnotations,
) -> list[BreakdownGroup]:
    surfaces = WORD_RE.findall(text)
    authored_meanings = {
        key.casefold(): value for key, value in annotations.word_meanings.items()
    }
    authored_bases = {
        key.casefold(): value for key, value in annotations.base_forms.items()
    }
    authored_tags = {
        key.casefold(): set(value) for key, value in annotations.word_tags.items()
    }
    source_words: list[BreakdownItem] = []
    for index, surface in enumerate(surfaces):
        try:
            item = _word_item(surface, lesson_targets, text, index)
        except ValueError as error:
            key = surface.casefold()
            base = authored_bases.get(key, surface)
            meaning = authored_meanings.get(
                key,
                TARGET_GLOSSES.get(
                    base, EXTRA_VERBS.get(base, COMMON_GLOSSES.get(base.casefold()))
                ),
            )
            if meaning is None or "Missing controlled gloss" not in str(error):
                raise
            labels = authored_tags.get(key, set())
            if labels & VERB_TAGS:
                help_card, item_meaning, tense_tags = _contextual_verb_help(
                    base, meaning, surface, text, index
                )
                item = BreakdownItem(
                    german=surface,
                    english=item_meaning,
                    tags=tense_tags,
                    verb_help=help_card,
                    source_forms=[surface],
                )
            else:
                item = BreakdownItem(
                    german=base,
                    english=meaning,
                    source_forms=[surface],
                )
        source_words.append(item)
    phrases: list[BreakdownItem] = [
        *_inversion_phrases(text, meaning, surfaces, source_words),
        *_contraction_phrases(surfaces, source_words),
        *_noun_phrases(surfaces, source_words, meaning, text),
        *_connector_phrases(text, meaning, surfaces, source_words),
    ]
    de_clauses = [part.strip(" .!?„“\"") for part in re.split(r"[,;:]", text)]
    en_clauses = [part.strip(" .!?“\"") for part in re.split(r"[,;:]", meaning)]
    if len(de_clauses) == len(en_clauses) and len(de_clauses) > 1:
        for german, english in zip(de_clauses, en_clauses, strict=True):
            if len(WORD_RE.findall(german)) >= 2:
                phrase_label = (
                    "subordinate clause"
                    if german.casefold().startswith(("weil ", "wenn ", "dass ", "ob ", "obwohl ", "als "))
                    else "main clause"
                )
                phrases.append(
                    BreakdownItem(
                        german=german,
                        english=english,
                        tags=[tag(phrase_label)],
                        kind="phrase",
                    )
                )
    folded_tokens = [token.casefold() for token in WORD_RE.findall(text)]
    for german, english in CURATED_PHRASES.items():
        phrase_tokens = [token.casefold() for token in WORD_RE.findall(german)]
        if any(
            folded_tokens[index : index + len(phrase_tokens)] == phrase_tokens
            for index in range(len(folded_tokens) - len(phrase_tokens) + 1)
        ):
            phrases.append(
                BreakdownItem(
                    german=german,
                    english=english,
                    tags=[tag("fixed phrase")],
                    kind="phrase",
                )
            )
    _apply_sentence_annotations(surfaces, source_words, phrases, annotations, text)
    separable_components = _link_authored_verb_components(
        surfaces,
        source_words,
        {key.casefold(): value for key, value in annotations.verb_components.items()},
    )
    words = [
        word
        for word in _compose_articles(surfaces, source_words)
        if id(word) not in separable_components
    ]
    group = BreakdownGroup(items=[*words, *_deduplicate_phrases(phrases)])
    return [attach_inflection_help(group)]


def compile_lesson(record: dict, introduced_targets: list[str]) -> Lesson:
    lesson_targets = [
        *introduced_targets,
        *record["recycled_targets"],
        *record["new_targets"],
    ]
    record_audio_path = record.get("audio_path")
    sentence_audio_paths = [
        sentence.get("audio_path") for sentence in record["sentences"]

