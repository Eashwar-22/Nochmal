 print(i, a['de']==b['de'], a['en']==b['en'], len(re.findall(r\"\\w+(?:[-’']\\w+)*\", a['de'], flags=re.UNICODE)), a['de'])
print('total',sum(len(re.findall(r\"\\w+(?:[-’']\\w+)*\", x['de'], flags=re.UNICODE)) for x in source['sentences']))
PY
