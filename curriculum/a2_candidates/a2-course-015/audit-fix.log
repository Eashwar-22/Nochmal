import json,re
from pathlib import Path
from nochmal.content.grammar_reference import table_for_help, selected_column_for_help
src=json.loads(Path('curriculum/a2_candidates/a2-course-015/lesson-source.json').read_text())
out=json.loads(Path('curriculum/a2_candidates/a2-course-015/compiled-lesson.json').read_text())
for no,(s,c) in enumerate(zip(src['sentences'],out['lesson']['sentences'],strict=True),1):
 toks=re.findall(r\"\\w+(?:[-’']\\w+)*\",s['de'],flags=re.UNICODE)
 cards=[x for g in c['breakdown_groups'] for x in g['items'] if x['kind']=='word']
 forms=[f for x in cards for f in x['source_forms']]
 print(no, 'coverage',sorted(t.casefold() for t in toks)==sorted(f.casefold() for f in forms), 'tokens',len(toks),'words',len(cards))
 for x in cards:
  labels={z['label'] for z in x['tags']}
  if 'verb' in labels: print(' verb',x['german'],bool(x['verb_help']))
 for x in [x for g in c['breakdown_groups'] for x in g['items'] if x['kind']=='phrase']:
  if x['inflection_help']:
   print(' inflect',x['german'], [(h['surface'],h['base'],h['case'],h['paradigm']) for h in x['inflection_help']])
