import hashlib,json,re
from pathlib import Path
from nochmal.content.candidates import candidate_errors,load_candidate_artifact
from nochmal.content.grammar_reference import selected_column_for_help,table_for_help
p=Path('curriculum/a2_candidates/a2-course-015')
source=json.loads((p/'lesson-source.json').read_text())
artifact=load_candidate_artifact('a2-course-015')
print('candidate_errors',candidate_errors('a2-course-015',artifact))
print('source_hash_matches',json.loads((p/'compiled-lesson.json').read_text())['source_sha256']==hashlib.sha256((p/'lesson-source.json').read_bytes()).hexdigest())
for sentence in artifact.lesson.sentences:
 for group in sentence.breakdown_groups:
  for item in group.items:
   for help_ in item.inflection_help:
    table=table_for_help(help_)
    assert len(table)==4 and table[help_.case][selected_column_for_help(help_)].casefold()==help_.surface.casefold(),help_
print('inflection_tables_verified')
print('tokens',sum(len(re.findall(r\"\\w+(?:[-’']\\w+)*\",s['de'])) for s in source['sentences']))
