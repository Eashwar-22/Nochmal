"""Build and load deterministic, unpublished lesson preview artifacts."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Literal

from .course_library import course_lessons, preceding_published_targets
from .course_paths import candidate_root, course_level
from .lesson_compiler import compile_lesson
from .models import Lesson, StrictModel
from .ordering import ordered_breakdown_items
from .source_models import CourseLessonSource
from .validation import validate_lesson_library


class LessonCandidateArtifact(StrictModel):
    schema_version: Literal[1]
    source_sha256: str
    lesson: Lesson


def candidate_directory(lesson_id: str) -> Path:
    return candidate_root(lesson_id) / lesson_id


def source_path(lesson_id: str) -> Path:
    return candidate_directory(lesson_id) / "lesson-source.json"


def artifact_path(lesson_id: str) -> Path:
    return candidate_directory(lesson_id) / "compiled-lesson.json"


def source_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_candidate_source(lesson_id: str) -> CourseLessonSource:
    path = source_path(lesson_id)
    if not path.is_file():
        raise ValueError(f"No lesson candidate source exists for {lesson_id!r}")
    source = CourseLessonSource.model_validate_json(path.read_text(encoding="utf-8"))
    if source.id != lesson_id:
        raise ValueError("Candidate directory and lesson source ID do not match")
    return source


def compile_candidate(source: CourseLessonSource) -> Lesson:
    level = course_level(source.id)
    introduced_targets = preceding_published_targets(level)
    introduced_targets.extend(
        target
        for lesson in course_lessons(level)
        if lesson.sequence is not None and lesson.sequence < source.sequence
        for target in lesson.new_targets
    )
    return compile_lesson(source.model_dump(mode="json"), introduced_targets)


def candidate_errors(lesson_id: str, artifact: LessonCandidateArtifact) -> list[str]:
    errors: list[str] = []
    source = load_candidate_source(lesson_id)
    expected_hash = source_sha256(source_path(lesson_id))
    if artifact.source_sha256 != expected_hash:
        errors.append("candidate source changed after the compiled artifact was built")
    if artifact.lesson.id != lesson_id:
        errors.append("compiled artifact lesson ID does not match its candidate directory")

    expected_lesson = compile_candidate(source)
    if artifact.lesson.model_dump(mode="json") != expected_lesson.model_dump(mode="json"):
        errors.append("compiled artifact does not match the deterministic compiler output")
    errors.extend(validate_lesson_library([artifact.lesson]))
    return errors


def load_candidate_artifact(lesson_id: str) -> LessonCandidateArtifact:
    path = artifact_path(lesson_id)
    if not path.is_file():
        raise ValueError(
            f"No compiled candidate exists for {lesson_id!r}; build it before previewing"
        )
    artifact = LessonCandidateArtifact.model_validate_json(
        path.read_text(encoding="utf-8")
    )
    errors = candidate_errors(lesson_id, artifact)
    if errors:
        raise ValueError("\n".join(f"- {error}" for error in errors))
    return artifact


def artifact_json(source: CourseLessonSource, lesson: Lesson) -> str:
    artifact = LessonCandidateArtifact(
        schema_version=1,
        source_sha256=source_sha256(source_path(source.id)),
        lesson=lesson,
    )
    return json.dumps(artifact.model_dump(mode="json"), ensure_ascii=False, indent=2) + "\n"


def preview_markdown(source: CourseLessonSource, lesson: Lesson) -> str:
    lines = [
        f"# Preview: {lesson.english_title}",
        "",
        f"- Candidate: `{lesson.id}`",
        f"- Source draft: `{source.source_draft_id}`",
        f"- Level: {lesson.level}",
        f"- Audio: {lesson.audio_status}",
        "",
        "> This file is generated before app activation. The app renders the same compiled cards.",
        "",
    ]
    for sentence_number, sentence in enumerate(lesson.sentences, start=1):
        lines.extend(
            [
                f"## Sentence {sentence_number}",
                "",
                f"**German:** {sentence.text}",
                "",
                f"**English:** {sentence.natural_meaning}",
                "",
                "| Type | German | Spoken German | English | Literal | Tags | Help |",
                "|---|---|---|---|---|---|---|",
            ]
        )
        for group in sentence.breakdown_groups:
            for item in ordered_breakdown_items(group, sentence.text):
                tags = ", ".join(tag.label for tag in item.tags) or "—"
                literal = item.literal_meaning or "—"
                help_parts: list[str] = []
                if item.verb_help:
                    help_parts.append(f"verb: {item.verb_help.infinitive}")
                help_parts.extend(
                    f"{help_.base} → {help_.surface} ({help_.case})"
                    for help_ in item.inflection_help
                )
                help_text = "; ".join(help_parts) or "—"
                cells = [
                    item.kind,
                    item.german,
                    item.spoken_form or "—",
                    item.english,
                    literal,
                    tags,
                    help_text,
                ]
                escaped = [cell.replace("|", "\\|") for cell in cells]
                lines.append("| " + " | ".join(escaped) + " |")
        lines.append("")
    if lesson.performance_activity is not None:
        lines.extend(
            [
                "## Performance activity",
                "",
                f"**Type:** {lesson.performance_activity.kind}",
                "",
                lesson.performance_activity.instruction,
                "",
            ]
        )
        lines.extend(
            f"- {prompt}" for prompt in lesson.performance_activity.prompts
        )
        lines.append("")
    return "\n".join(lines)
"""Strict schemas for authored curriculum files.

The compiled UI models describe what the app renders.  These models validate
the author-owned JSON before the compiler is allowed to transform it.
"""

from __future__ import annotations

import re
from typing import Literal

from pydantic import Field, model_validator

from .models import (
    PerformanceActivity,
    SentenceAnnotations,
    SpeechAlternative,
    StrictModel,
)


TOKEN_PATTERN = re.compile(r"\w+(?:[-’']\w+)*", flags=re.UNICODE)


def normalized_tokens(text: str) -> list[str]:
    return [token.casefold() for token in TOKEN_PATTERN.findall(text)]


def phrase_occurs_in_order(source: str, phrase: str) -> bool:
    """Accept contiguous phrases and ordered chunks separated by an ellipsis."""

    source_tokens = normalized_tokens(source)
    chunks = [
        normalized_tokens(chunk)
        for chunk in re.split(r"\.{3}|…", phrase)
        if normalized_tokens(chunk)
    ]
    cursor = 0
    for chunk in chunks:
        for index in range(cursor, len(source_tokens) - len(chunk) + 1):
            if source_tokens[index : index + len(chunk)] == chunk:
                cursor = index + len(chunk)
                break
        else:
            return False
    return bool(chunks)


class ComprehensionSource(StrictModel):
    question_en: str
    answer_en: str


class CourseSentenceSource(StrictModel):
    de: str
    en: str
    audio_path: str | None = None
    annotations: SentenceAnnotations = Field(default_factory=SentenceAnnotations)

    @model_validator(mode="after")
    def require_annotations_to_reference_the_sentence(self) -> "CourseSentenceSource":
        source_tokens = set(normalized_tokens(self.de))
        keyed_annotations = {
            "word_tags": self.annotations.word_tags,
            "excluded_word_tags": self.annotations.excluded_word_tags,
            "base_forms": self.annotations.base_forms,
            "word_meanings": self.annotations.word_meanings,
            "verb_meanings": self.annotations.verb_meanings,
            "verb_forms": self.annotations.verb_forms,
            "verb_components": self.annotations.verb_components,
            "spoken_forms": self.annotations.spoken_forms,
        }
        for field_name, values in keyed_annotations.items():
            missing = sorted(key for key in values if key.casefold() not in source_tokens)
            if missing:
                raise ValueError(
                    f"{field_name} keys are absent from the German sentence: {missing}"
                )

        missing_components = sorted(
            component
            for components in self.annotations.verb_components.values()
            for component in components
            if component.casefold() not in source_tokens
        )
        if missing_components:
            raise ValueError(
                "verb_components values are absent from the German sentence: "
                + ", ".join(missing_components)
            )

        occurrence_counts: dict[str, int] = {}
        for token in normalized_tokens(self.de):
            occurrence_counts[token] = occurrence_counts.get(token, 0) + 1
        invalid_occurrences = [
            f"{item.surface}#{item.occurrence}"
            for item in self.annotations.word_occurrences
            if occurrence_counts.get(item.surface.casefold(), 0) < item.occurrence
        ]
        if invalid_occurrences:
            raise ValueError(
                "word_occurrences entries are absent or out of range: "
                + ", ".join(invalid_occurrences)
            )

        phrase_fields = {
            "phrases": [item.german for item in self.annotations.phrases],
            "excluded_phrases": self.annotations.excluded_phrases,
            "excluded_phrase_tags": list(self.annotations.excluded_phrase_tags),
        }
        for field_name, phrases in phrase_fields.items():
            absent = [
                phrase
                for phrase in phrases
                if not phrase_occurs_in_order(self.de, phrase)
            ]
            if absent:
                raise ValueError(
                    f"{field_name} entries are absent or out of order: {absent}"
                )

        normalized = [
            " ".join(normalized_tokens(item.german))
            for item in self.annotations.phrases
        ]
        if len(normalized) != len(set(normalized)):
            raise ValueError("Authored phrases must not contain duplicates")
        return self


class CourseLessonSource(StrictModel):
