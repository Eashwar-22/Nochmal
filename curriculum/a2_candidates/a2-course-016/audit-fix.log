                audio_path = project_root / relative_path
                if not audio_path.is_file():
                    errors.append(f"{context}: missing audio file {relative_path!r}")
                elif audio_path.read_bytes()[:4] != b"RIFF":
                    errors.append(f"{context}: audio is not a WAV file: {relative_path!r}")

        for sentence in lesson.sentences:
            sentence_context = f"{context}, sentence {sentence.text!r}"
            if not sentence.text.strip():
                errors.append(f"{sentence_context}: source text is empty")
            if not sentence.natural_meaning.strip():
                errors.append(f"{sentence_context}: translation is empty")
            if not sentence.breakdown_groups:
                errors.append(f"{sentence_context}: breakdown is empty")

            source_tokens = _tokens(sentence.text)
            items = [
                item
                for group in sentence.breakdown_groups
                for item in group.items
            ]
            phrase_tokens = {
                token
                for item in items
                if item.kind == "phrase"
                for token in _tokens(item.german)
            }

            for item in items:
                item_context = f"{sentence_context}, item {item.german!r}"
                labels = {tag.label for tag in item.tags}

                if item.kind == "phrase":
                    unexpected = _tokens(item.german) - source_tokens
                    if unexpected:
                        errors.append(
                            f"{item_context}: phrase contains words absent from "
                            f"the source: {', '.join(sorted(unexpected))}"
                        )

                if item.kind == "word" and labels & VERB_TAGS:
                    help_card = item.verb_help
                    if help_card is None:
                        errors.append(f"{item_context}: verb help is missing")
                    elif (
                        not help_card.forms
                        or not help_card.infinitive.strip()
                        or not help_card.tense.strip()
                        or not help_card.usage.strip()
                        or any(
                            not form.pronoun.strip() or not form.verb.strip()
                            for form in help_card.forms
                        )
                    ):
                        errors.append(f"{item_context}: verb help is incomplete")
                    else:
                        try:
                            english_infinitive(help_card)
                            reference_for(help_card)
                            present = present_forms(help_card)
                            present_english = english_present_forms(help_card)
                            current_english = english_current_forms(help_card)
                        except ValueError as error:
                            if help_card.english:
                                try:
                                    present = present_forms(help_card)
                                    present_english = english_present_forms(help_card)
                                    current_english = english_current_forms(help_card)
                                except ValueError as embedded_error:
                                    errors.append(f"{item_context}: {embedded_error}")
                                    continue
                            else:
                                errors.append(f"{item_context}: {error}")
                                continue
                        if not (
                            len(present) == len(present_english) == 6
                            and len(help_card.forms) == len(current_english)
                        ):
                            errors.append(
                                f"{item_context}: the present table must contain "
                                "six bilingual forms and the sentence-tense table "
                                "must have matching German/English rows"
                            )

                if (
                    item.kind == "word"
                    and "article" in labels
                    and item.english.casefold() in {"a", "an", "the"}
                ):
                    errors.append(
                        f"{item_context}: compose the article into a noun phrase"
                    )

                visible_forms = {
                    item.german.casefold(),
                    *(form.casefold() for form in item.source_forms),
                }
                if "preposition" in labels and not visible_forms & phrase_tokens:
                    errors.append(
                        f"{item_context}: preposition is not shown in a phrase result"
                    )

                used_contractions = {
                    form.casefold()
                    for form in item.source_forms
                    if form.casefold() in CONTRACTIONS
                }
                missing_contractions = used_contractions - phrase_tokens
                if missing_contractions:
                    errors.append(
                        f"{item_context}: contraction is not shown in a phrase "
                        f"result: {', '.join(sorted(missing_contractions))}"
                    )

    return errors


def assert_valid_lesson_library(
    lessons: Iterable[Lesson], *, project_root: Path | None = None
) -> None:
    """Raise one readable exception containing all authoring failures."""

    errors = validate_lesson_library(lessons, project_root=project_root)
    if errors:
        raise LessonValidationError("\n".join(f"- {error}" for error in errors))
    """Structured, sentence-owned inputs consumed by the generic compiler."""

    word_tags: dict[str, list[str]] = Field(default_factory=dict)
    excluded_word_tags: dict[str, list[str]] = Field(default_factory=dict)
    base_forms: dict[str, str] = Field(default_factory=dict)
    word_meanings: dict[str, str] = Field(default_factory=dict)
    verb_meanings: dict[str, str] = Field(
        default_factory=dict, exclude_if=lambda value: not value
    )
    verb_forms: dict[str, Literal["infinitive"]] = Field(
        default_factory=dict, exclude_if=lambda value: not value
    )
    verb_components: dict[str, list[str]] = Field(
        default_factory=dict, exclude_if=lambda value: not value
    )
    spoken_forms: dict[str, str] = Field(default_factory=dict)
    word_occurrences: list[WordOccurrenceAnnotation] = Field(default_factory=list)
    excluded_phrases: list[str] = Field(default_factory=list)
    excluded_phrase_tags: dict[str, list[str]] = Field(default_factory=dict)
    phrases: list[AuthoredPhrase] = Field(default_factory=list)

    @model_validator(mode="after")
    def require_controlled_word_tags(self) -> "SentenceAnnotations":
        unknown = {
            label
            for labels in self.word_tags.values()
            for label in labels
            if label not in TAG_KEYWORDS
        }
        if unknown:
            raise ValueError(f"Unknown authored word tags: {sorted(unknown)}")
        unknown_excluded = {
            label
            for labels in self.excluded_word_tags.values()
            for label in labels
            if label not in TAG_KEYWORDS
        } | {
            label
            for labels in self.excluded_phrase_tags.values()
            for label in labels
            if label not in TAG_KEYWORDS
        }
        if unknown_excluded:
            raise ValueError(
                f"Unknown excluded phrase tags: {sorted(unknown_excluded)}"
            )
        occurrence_keys = [
            (item.surface.casefold(), item.occurrence)
            for item in self.word_occurrences
        ]
        if len(occurrence_keys) != len(set(occurrence_keys)):
            raise ValueError("Occurrence-specific word annotations must be unique")
        return self


class Sentence(StrictModel):
    text: str
    natural_meaning: str
    breakdown_groups: list[BreakdownGroup]
    audio_path: str | None

    @model_validator(mode="after")
    def require_a_gloss_for_every_word(self) -> "Sentence":
        """Keep every source form represented by a vocabulary breakdown."""
        word_pattern = r"\w+(?:[-’']\w+)*"
        source_words = {
            word.casefold()
            for word in re.findall(word_pattern, self.text, flags=re.UNICODE)
        }
        vocabulary_items = [
            item
            for group in self.breakdown_groups
            for item in group.items
            if item.kind == "word"
        ]
        glossed_words = {
            word.casefold()
            for item in vocabulary_items
            for word in (
                re.findall(word_pattern, item.german, flags=re.UNICODE)
                + item.source_forms
            )
        }
        missing = sorted(source_words - glossed_words)
        if missing:
            raise ValueError(
                "Every sentence word needs its own breakdown; missing: "
                f"{', '.join(missing)}"
            )

        return self


class SpeechAlternative(StrictModel):
    """A meaning-preserving phrase accepted by a speaking-practice lesson."""

- **Target passage:** Recommendation message plus reply; 6 sentences/turns; about 86–96 words.
- **Connectedness:** The reply asks about details of the exact item introduced and described in the message.
- **New vocabulary or chunks:** `der Roman`; `der Beitrag`; `die Handlung`; `spannend`; `unterhaltsam`; `veröffentlichen`; `ausleihen`.
- **Deliberately recycled:** relative clauses (L51); media and reading (A1 L39); opinions (L50); object pronouns (L39); comparisons.
- **Performance activity:** **Writing:** Recommend two familiar items using one nominative and one accusative relative clause.

### Lesson 53 — Better Than the Last One

- **Module:** 9 — Learning, media, culture, and opinions
- **Real-life situation:** Comparing cultural experiences and reaching a shared choice.
- **Can do:** I can express difference and equality in a familiar evaluation.

